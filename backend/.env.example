# Jwel API — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase (public project settings — anon key is safe for the client)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY. Never expose to the frontend.
# SUPABASE_SERVICE_ROLE_KEY=