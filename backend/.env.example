NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection string (Supabase Dashboard → Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.REF.supabase.co:5432/postgres

# Supabase project credentials
# URL and Anon key: Dashboard → Project Settings → API
# Service role key: Dashboard → Project Settings → API → service_role (KEEP SECRET, server-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
